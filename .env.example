# Tarot Reader Environment Variables Template
# Copy this file to .env.local for local development

# Mode: set to true to test locally with canned readings and no Firebase calls
VITE_USE_MOCK=false

# Firebase Web App Config (Public client identifiers, safe to expose)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef1234567890
VITE_APPCHECK_SITE_KEY=your_recaptcha_site_key
# Set to true if you selected "Fraud Defense (formerly known as reCAPTCHA Enterprise)" in Firebase App Check
# VITE_APPCHECK_IS_ENTERPRISE=true
# Optional: Fixed debug token for local localhost testing with App Check
# VITE_APPCHECK_DEBUG_TOKEN=your_debug_token_uuid

# Gemini Models for Firebase AI Logic
VITE_GEMINI_MODEL=gemini-3.8-flash
VITE_GEMINI_FALLBACK_MODEL=gemini-3.5-flash
